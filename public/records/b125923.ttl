    bf:subject <http://id.loc.gov/authorities/subjects/sh85068499>, <http://id.loc.gov/authorities/genreForms/gf2014026139>, [
        a bf:Place ;
        rdfs:label "إيران -- تاريخ الفلسفة -- القرن 11 هـ"@ar-Arab
    ], [
        a bf:Agent ;
        rdfs:label "الميرداماد، محمد باقر بن محمد، توفي 1041 هـ"@ar-Arab
    ] ;
    bf:genreForm <http://id.loc.gov/authorities/genreForms/gf2014026139> ;
    bf:summary [
        a bf:Summary ;
        rdfs:label "كتاب فلسفي كلامي للميرداماد يناقش حدوث العالم وقدمه ومسألة الدهر والزمان والمصادر الوجودية وفق الحكمة المتعالية والمشائية."@ar-Arab
    ] ;
    bf:tableOfContents [
        a bf:TableOfContents ;
        rdfs:label "مقدمة في حدوث العالم، الومضة الأولى في الوجود والعدم، القبسة الأولى في مراتب الوجود والدهر والسرمد، القبسة الثانية في إثبات الواجب، القبسة الثالثة في الحركة والزمان والآن."@ar-Arab
    ] ;
    bf:originDate "1650 [1061 هـ.]"@ar-Arab ;
    bf:date "1650" ;
    bf:originPlace <http://id.loc.gov/vocabulary/countries/ir>, [
        rdfs:label "طهران، ايران / كربلاء المقدسة"@ar-Arab
    ] ;
    bf:temporalCoverage "1041-1061 هـ. / القرن 17 الميلادي"@ar-Arab ;
    bf:note [
        a bf:Note ;
        rdfs:label "أوله : الحمد لله الواحد الاحد الصمد المصمود مهيمن كل وجود وجاعل كل موجود، والصلاة على من اقتفاه من زمرة الانبياء، واصطفاه من رسل الرسل فابتعثه بالذكر..."@ar-Arab
    ], [
        a bf:Note ;
        rdfs:label "آخره : ولا تخلنا اللهم مع ذلك من عواطف رأفتك وسوابغ رحمتك ولطايف كفايتك وحوط عنايتك وحسن كلائتك بجودك ومنك وفضلك وطولك يا أرحم الراحمين."@ar-Arab
    ], [
        a bf:Note ;
        rdfs:label "الذريعة الى تصانيف الشيعة، الجزء 17، الصفحه 32، الرقم 183."@ar-Arab
    ], [
        a bf:Note ;
        rdfs:label "مكتبة مجلس الشورى : 4662، طهران، ايران (ir)"@ar-Arab
    ], [
        a bf:Note ;
        rdfs:label "أوله: الحمد لله الواحد الاحد الصمد المصمود مهيمن كل وجود وجاعل كل موجود...\nآخره: ولا تخلنا اللهم مع ذلك من عواطف رأفتك وسوابغ رحمتك ولطايف كفايتك وحوط عنايتك...\nالذريعة الى تصانيف الشيعة: ج 17، ص 32، رقم 183.\nمكتبة مجلس الشورى: 4662، طهران، ايران."@ar-Arab
    ] ;
